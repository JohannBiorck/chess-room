# Local development settings. Choose separate application and administrator passwords.
HOST=127.0.0.1
PORT=3001
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-administrator-password
DATABASE_URL=postgresql://chess_room:replace-with-a-local-password@127.0.0.1:5433/chess_room
# Required only for disposable local integration tests that create restricted-role fixtures.
ADMIN_DATABASE_URL=postgresql://chess_room_admin:replace-with-a-separate-administrator-password@127.0.0.1:5433/chess_room
# Hosted startup requires a separate database/schema owner for migrations.
# Configure this as a service secret, together with a restricted runtime DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://migration_owner:replace-with-owner-password@database-host/database?sslmode=verify-full
WEB_ORIGIN=http://127.0.0.1:5173
# Set true to serve the built browser app from the application server.
SERVE_WEB=false
# Trust only the exact IP or CIDR of your reverse proxy. Empty means none.
TRUST_PROXY=
