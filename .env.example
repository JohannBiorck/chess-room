# Local development settings. Copy to .env and choose a database password.
HOST=127.0.0.1
PORT=3001
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-administrator-password
DATABASE_URL=postgresql://chess_room:replace-with-a-local-password@127.0.0.1:5433/chess_room
WEB_ORIGIN=http://127.0.0.1:5173
# Set true to serve the built browser app from the application server.
SERVE_WEB=false
# Trust only the exact IP or CIDR of your reverse proxy. Empty means none.
TRUST_PROXY=
